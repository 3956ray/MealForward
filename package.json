{
  "name": "mealforward-local-mvp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "chain:node": "node scripts/local-node.mjs",
    "chain:deploy": "node scripts/deploy-local.mjs",
    "chain:test": "forge test",
    "chain:e2e": "node scripts/chain-e2e.mjs",
    "dev:wallet": "vite --config wallet-harness/vite.config.ts",
    "test:wallet": "node --experimental-strip-types --test tests/wallet/*.test.ts",
    "dev:dynamic": "vite --config dynamic-harness/vite.config.ts",
    "build:dynamic": "tsc --noEmit && vite build --config dynamic-harness/vite.config.ts"
  },
  "dependencies": {
    "@dynamic-labs-sdk/client": "1.38.0",
    "@dynamic-labs-sdk/evm": "1.38.0",
    "@dynamic-labs-sdk/react-hooks": "1.38.0",
    "@tanstack/react-query": "5.104.1",
    "qrcode.react": "4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "2.57.1"
  },
  "overrides": {
    "@dynamic-labs-wallet/core@1.1.24": {
      "axios": "1.20.0"
    }
  },
  "devDependencies": {
    "@foundry-rs/anvil": "1.7.1",
    "@foundry-rs/forge": "1.7.1",
    "@openzeppelin/contracts": "5.6.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "8.3.1"
  }
}
